# Copy to .env (in the repo root) and fill in what you need. Every setting is optional:
# with an empty .env the app runs on a shared Helius key that ships with the project.

# --- Solana RPC ---------------------------------------------------------------------------
# Empty: the shared free-plan key in backend/src/config.js, used by everyone who runs the app
# without their own, so it can run out of credits. Your own free key (https://dashboard.helius.dev)
# avoids that.
HELIUS_API_KEY=
# Or any other RPC provider (overrides HELIUS_API_KEY):
# RPC_URL=https://your-rpc.example
# WS_URL=wss://your-rpc.example

# --- Server -------------------------------------------------------------------------------
# API port and address. The frontend dev server (npm run dev, port 5180) proxies /api here.
# PORT=3020
# HOST=127.0.0.1
# Public address, for link previews. Empty: taken from each request's Host header.
# PUBLIC_URL=https://example.com
# Where orders, candles and caches are stored (default: data/ in the repo root).
# DATA_DIR=./data

# --- Automatic payouts --------------------------------------------------------------------
# The keeper submits users' pre-signed payouts once their orders fill and pays the network fee
# (~0.00001 SOL each). A keypair is generated at data/keeper.json on first start; fund it with
# a little SOL. Or point this at an existing Solana keypair file (JSON array):
# KEEPER_KEYPAIR=/path/to/keypair.json

# --- History ------------------------------------------------------------------------------
# Order history is read from each wallet's own transactions on-chain (Manifest orders placed
# anywhere, Jupiter swaps), this many days back, and cached in data/history/.
# HISTORY_DAYS=365

# --- Optional -----------------------------------------------------------------------------
# Jupiter API key (https://portal.jup.ag), for higher rate limits on token lists and prices.
# JUP_API_KEY=
# Name used in link previews (the UI's name is in frontend/src/brand.js).
# BRAND=SpotTerminal
